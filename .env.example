# Anthropic API key — used by every cycle's Claude session.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token. Required when:
#   - workspace.type = "git"     (used to clone + push)
#   - shipper.type   = "git_pr"  (used to open PRs / merge)
# A fine-grained token scoped to the single repo is preferred. Needs:
#   - repo (read+write code, issues, PRs)
#   - workflow (only if your CI checks out workflow files)
GITHUB_TOKEN=ghp_...

# Optional: override path to the orchestrator's config.toml. If unset, the
# CLI reads ./config.toml.
# ORCHESTRATOR_CONFIG=/etc/agent-orchestrator/config.toml

# Optional: log level (DEBUG / INFO / WARNING). Default INFO.
# LOG_LEVEL=INFO
