# dev-ops-agents-orchestrator environment

# The Anthropic key the dev-ops orchestrator itself uses.
ANTHROPIC_API_KEY=

# One GitHub token PER watched orchestrator. Names must match the
# `github_token = { env = "..." }` entries in orchestrators.toml.
# Each token needs: repo (read+write), pull_requests (write).
GH_TOKEN_CODING=
GH_TOKEN_MARKETING=
GH_TOKEN_RESEARCH=
